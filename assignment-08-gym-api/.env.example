# Server port
PORT=5000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/gym_fitness_club
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gym_fitness_club?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/gym_fitness_club

# Secret used to sign the express-session cookie. Use a long random string in production.
SESSION_SECRET=change_this_to_a_long_random_secret
